# GitHub owner for image names (lowercase, no spaces)
GITHUB_REPOSITORY_OWNER=your-github-username

# Database
DATABASE_PROVIDER=sqlite
CONNECTION_STRING=Data Source=/data/dealme.db

# changedetection.io
CDIO_API_KEY=your_cdio_api_key_here
CDIO_BASE_URL=http://changedetection:5000

# Deal filtering
MIN_DEAL_VALUE=5.00
TIMEZONE=Australia/Melbourne

# Notification channel (Apprise URL format)
# Examples:
#   discord://webhook_id/webhook_token
#   slack://TokenA/TokenB/TokenC
DEFAULT_NOTIFICATION_URL=discord://your_id/your_token

# Product search (optional — omit to use StaticIce only)
# Free tier: 2500 searches/month at https://serper.dev
SERPER_API_KEY=
